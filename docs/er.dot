digraph ERD {
  graph [rankdir=LR, splines=polyline, nodesep=0.5, ranksep=1.6, fontname="Helvetica", bgcolor="white", pad=0.4, label="PSU Sales & Inventory System - Entity Relationship Diagram (Crow's Foot)", labelloc=t, fontsize=20];
  node  [shape=plain, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10, dir=both, arrowtail=teetee, arrowhead=crowodot, color="#334155"];

  users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="2" bgcolor="#1e3a8a"><font color="white"><b>users</b></font></td></tr>
    <tr><td bgcolor="#fef3c7">PK</td><td align="left"><b>id</b> INT</td></tr>
    <tr><td></td><td align="left">name VARCHAR(100)</td></tr>
    <tr><td bgcolor="#e0e7ff">UK</td><td align="left">username VARCHAR(50)</td></tr>
    <tr><td></td><td align="left">password (bcrypt hash)</td></tr>
    <tr><td></td><td align="left">role ENUM(admin,cashier,clerk)</td></tr>
    <tr><td></td><td align="left">active TINYINT</td></tr>
    <tr><td></td><td align="left">created_at DATETIME</td></tr></table>>];

  suppliers [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="2" bgcolor="#1e3a8a"><font color="white"><b>suppliers</b></font></td></tr>
    <tr><td bgcolor="#fef3c7">PK</td><td align="left"><b>id</b> INT</td></tr>
    <tr><td bgcolor="#e0e7ff">UK</td><td align="left">name VARCHAR(150)</td></tr>
    <tr><td></td><td align="left">contact_person, phone</td></tr>
    <tr><td></td><td align="left">email, address</td></tr>
    <tr><td></td><td align="left">created_at DATETIME</td></tr></table>>];

  products [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="2" bgcolor="#1e3a8a"><font color="white"><b>products</b></font></td></tr>
    <tr><td bgcolor="#fef3c7">PK</td><td align="left"><b>id</b> INT</td></tr>
    <tr><td bgcolor="#e0e7ff">UK</td><td align="left">code VARCHAR(30)</td></tr>
    <tr><td></td><td align="left">name, category</td></tr>
    <tr><td></td><td align="left">price, cost DECIMAL(12,2)</td></tr>
    <tr><td></td><td align="left">stock, reorder_level INT</td></tr>
    <tr><td bgcolor="#dcfce7">FK</td><td align="left">supplier_id &#8594; suppliers.id</td></tr>
    <tr><td></td><td align="left">active, created_at</td></tr></table>>];

  sales [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="2" bgcolor="#1e3a8a"><font color="white"><b>sales</b></font></td></tr>
    <tr><td bgcolor="#fef3c7">PK</td><td align="left"><b>id</b> INT</td></tr>
    <tr><td bgcolor="#e0e7ff">UK</td><td align="left">receipt_no VARCHAR(40)</td></tr>
    <tr><td bgcolor="#dcfce7">FK</td><td align="left">user_id &#8594; users.id</td></tr>
    <tr><td></td><td align="left">subtotal, tax, total</td></tr>
    <tr><td></td><td align="left">payment_method</td></tr>
    <tr><td></td><td align="left">amount_received, change_amount</td></tr>
    <tr><td></td><td align="left">created_at DATETIME</td></tr></table>>];

  sale_items [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="2" bgcolor="#1e3a8a"><font color="white"><b>sale_items</b></font></td></tr>
    <tr><td bgcolor="#fef3c7">PK</td><td align="left"><b>id</b> INT</td></tr>
    <tr><td bgcolor="#dcfce7">FK</td><td align="left">sale_id &#8594; sales.id</td></tr>
    <tr><td bgcolor="#dcfce7">FK</td><td align="left">product_id &#8594; products.id</td></tr>
    <tr><td></td><td align="left">name (snapshot)</td></tr>
    <tr><td></td><td align="left">qty INT</td></tr>
    <tr><td></td><td align="left">price, cost (snapshot)</td></tr></table>>];

  purchases [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="2" bgcolor="#1e3a8a"><font color="white"><b>purchases</b></font></td></tr>
    <tr><td bgcolor="#fef3c7">PK</td><td align="left"><b>id</b> INT</td></tr>
    <tr><td bgcolor="#e0e7ff">UK</td><td align="left">po_no VARCHAR(40)</td></tr>
    <tr><td bgcolor="#dcfce7">FK</td><td align="left">supplier_id &#8594; suppliers.id</td></tr>
    <tr><td bgcolor="#dcfce7">FK</td><td align="left">user_id &#8594; users.id</td></tr>
    <tr><td></td><td align="left">total DECIMAL(12,2)</td></tr>
    <tr><td></td><td align="left">created_at DATETIME</td></tr></table>>];

  purchase_items [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="2" bgcolor="#1e3a8a"><font color="white"><b>purchase_items</b></font></td></tr>
    <tr><td bgcolor="#fef3c7">PK</td><td align="left"><b>id</b> INT</td></tr>
    <tr><td bgcolor="#dcfce7">FK</td><td align="left">purchase_id &#8594; purchases.id</td></tr>
    <tr><td bgcolor="#dcfce7">FK</td><td align="left">product_id &#8594; products.id</td></tr>
    <tr><td></td><td align="left">name (snapshot)</td></tr>
    <tr><td></td><td align="left">qty INT</td></tr>
    <tr><td></td><td align="left">unit_cost DECIMAL(12,2)</td></tr></table>>];

  users     -> sales          [label="records"];
  users     -> purchases      [label="creates"];
  suppliers -> products       [label="supplies"];
  suppliers -> purchases      [label="receives"];
  sales     -> sale_items     [label="contains"];
  purchases -> purchase_items [label="contains"];
  products  -> sale_items     [label="sold in"];
  products  -> purchase_items [label="restocked in"];
}
